<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 作者：pangzhihao。公共查询和管理查询使用同一筛选 SQL，私有字段按视图范围读取。 -->
<mapper namespace="cn.edu.usedcar.mapper.VehicleMapper">
    <resultMap id="vehicleRow" type="cn.edu.usedcar.model.VehicleRecord">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="brand_id" javaType="_long"/>
            <arg column="brand_name" javaType="string"/>
            <arg column="city_id" javaType="_long"/>
            <arg column="city_name" javaType="string"/>
            <arg column="model" javaType="string"/>
            <arg column="registration_year" javaType="_int"/>
            <arg column="mileage" javaType="_int"/>
            <arg column="price" javaType="java.math.BigDecimal"/>
            <arg column="transmission" javaType="cn.edu.usedcar.model.Transmission"/>
            <arg column="fuel" javaType="cn.edu.usedcar.model.Fuel"/>
            <arg column="sale_mode" javaType="cn.edu.usedcar.model.SaleMode"/>
            <arg column="description" javaType="string"/>
            <arg column="status" javaType="cn.edu.usedcar.model.VehicleStatus"/>
            <arg column="listed_at" javaType="java.time.LocalDateTime"/>
            <arg column="owner_name" javaType="string"/>
            <arg column="review_note" javaType="string"/>
            <arg column="reviewed_at" javaType="java.time.LocalDateTime"/>
            <arg column="revision" javaType="java.lang.Long"/>
            <arg column="cover_photo_id" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <!-- 公共列表、详情和附件共用代销有效性条件，直销只需满足在售状态。 -->
    <sql id="eligibleSaleMode">
        (v.sale_mode = 'DIRECT' OR EXISTS (
            SELECT 1 FROM consignment cons
            WHERE cons.vehicle_id = v.id AND cons.owner_id = v.owner_id
              AND cons.status = 'APPROVED' AND cons.starts_at &lt;= #{businessNow}
              AND cons.expires_at &gt; #{businessNow}
        ))
    </sql>

    <!-- 实时把无有效委托的上架车显示为已下架，查询不写数据库。 -->
    <sql id="effectiveStatus">
        CASE WHEN v.status = 'LISTED' AND NOT <include refid="eligibleSaleMode"/> THEN 'OFFLINE' ELSE v.status END
    </sql>

    <!-- 公开读取和管理读取在这里应用各自的状态筛选。 -->
    <sql id="filterState">
        <choose>
            <!-- 管理端按界面显示的有效状态筛选，包括自然失效的代销车。 -->
            <when test="managed and status != null">AND (<include refid="effectiveStatus"/>) = #{status}</when>
            <!-- 公开侧同时核对持久化上架状态和当前代销资格。 -->
            <when test="!managed">AND v.status = 'LISTED' AND <include refid="eligibleSaleMode"/></when>
        </choose>
    </sql>

    <sql id="vehicleView">
        SELECT v.id, v.brand_id, b.name AS brand_name, v.city_id, c.name AS city_name, v.model,
               v.registration_year, v.mileage, v.price, v.transmission, v.fuel, v.sale_mode,
               v.description, <include refid="effectiveStatus"/> AS status, v.listed_at,
        <choose>
            <when test="managed">
                u.display_name AS owner_name, v.review_note, v.reviewed_at,
                COALESCE((SELECT MAX(a.id) FROM audit_log a
                  WHERE a.subject_type = 'VEHICLE' AND a.subject_id = v.id
                    AND a.action IN ('SUBMIT_VEHICLE', 'ADD_VEHICLE_PHOTO')), 0) AS revision
            </when>
            <otherwise>
                NULL AS owner_name, NULL AS review_note, CAST(NULL AS DATETIME) AS reviewed_at, NULL AS revision
            </otherwise>
        </choose>
        , (SELECT MIN(p.id) FROM attachment p WHERE p.vehicle_id = v.id AND p.kind = 'PHOTO') AS cover_photo_id
        FROM vehicle v
        JOIN brand b ON b.id = v.brand_id
        JOIN city c ON c.id = v.city_id
        <if test="managed">JOIN app_user u ON u.id = v.owner_id</if>
    </sql>

    <select id="selectVehiclePage" resultMap="vehicleRow">
        <include refid="vehicleView"/>
        <where>
            <include refid="filterState"/> <!-- 应用公开或管理端状态筛选。 -->
            <if test="ownerId != null">AND v.owner_id = #{ownerId}</if>
            <if test="criteria != null">
                <if test="criteria.brandId != null">AND v.brand_id = #{criteria.brandId}</if>
                <if test="criteria.cityId != null">AND v.city_id = #{criteria.cityId}</if>
                <if test="criteria.saleMode != null">AND v.sale_mode = #{criteria.saleMode}</if>
                <if test="criteria.minPrice != null">AND v.price &gt;= #{criteria.minPrice}</if>
                <if test="criteria.maxPrice != null">AND v.price &lt;= #{criteria.maxPrice}</if>
                <if test="criteria.minYear != null">AND v.registration_year &gt;= #{criteria.minYear}</if>
                <if test="criteria.maxYear != null">AND v.registration_year &lt;= #{criteria.maxYear}</if>
                <if test="criteria.minMileage != null">AND v.mileage &gt;= #{criteria.minMileage}</if>
                <if test="criteria.maxMileage != null">AND v.mileage &lt;= #{criteria.maxMileage}</if>
            </if>
        </where>
        <choose>
            <when test="managed">ORDER BY v.created_at DESC, v.id DESC</when>
            <otherwise>ORDER BY v.listed_at DESC, v.id DESC</otherwise>
        </choose>
    </select>

    <select id="selectView" resultMap="vehicleRow">
        <include refid="vehicleView"/>
        WHERE v.id = #{id}
        <include refid="filterState"/> <!-- 与列表使用一致的可见范围。 -->
        <if test="ownerId != null">AND v.owner_id = #{ownerId}</if>
    </select>

    <!-- 媒体列表可通过布尔查询校验车源是否仍可公开读取。 -->
    <select id="isPublic" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM vehicle v WHERE v.id = #{id}
            AND v.status = 'LISTED' AND <include refid="eligibleSaleMode"/>)
    </select>
</mapper>
